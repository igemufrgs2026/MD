; ============================================================
; EQ1 - NVT: aquecimento inicial a 100 K, restraints maximos
;
; MODIFICACOES:
;   [1] Pcoupl = no  (era berendsen)
;       MOTIVO: Esta e a etapa NVT pura. Nao ha barostato.
;               O volume e fixo aqui para estabilizar a
;               temperatura antes de ativar o controle de pressao.
;               Ir direto para NPT com sistema frio e tenso
;               pode gerar instabilidades no barostato.
;
;   [2] ref_t = 100 100  (era 310)
;       MOTIVO: Aquecimento gradual. Comecar a 310 K com
;               restraints altos e sistema recém-minimizado
;               e um choque termico. A temperatura deve subir
;               em etapas para dar tempo ao sistema de se
;               reorganizar energeticamente.
;
;   [3] gen_temp = 100.0  (era 310.0)
;       MOTIVO: Consistente com ref_t. As velocidades iniciais
;               devem ser geradas na mesma temperatura alvo.
; ============================================================

title               =  EQ1 - NVT 100K restraints maximos
define              =  -DPOSRES
constraints         =  all-bonds
integrator          =  md
tinit               =  0.0
dt                  =  0.002
nsteps              =  150000       ; 300 ps
cutoff-scheme       = Verlet
nstlist             = 20
comm-mode           = Linear
comm-grps           = System
nstxout             =  0
nstvout             =  0
nstfout             =  0
nstlog              =  100
nstenergy           =  100
coulombtype         =  PME
rlist               =  1.2
rcoulomb            =  1.2
vdwtype             =  cut-off
rvdw                =  1.2
fourierspacing      =  0.12
fourier_nx          =  0
fourier_ny          =  0
fourier_nz          =  0
pme_order           =  4
ewald_rtol          =  1e-5
optimize_fft        =  yes
Tcoupl              =  v-rescale
tc_grps             =  Protein Non-Protein
tau_t               =  0.1 0.1
ref_t               =  100 100      ; [*] MODIFICADO: era 310 310
Pcoupl              =  no           ; [*] MODIFICADO: era berendsen
gen_vel             =  yes
gen_temp            =  100.0        ; [*] MODIFICADO: era 310.0
gen_seed            =  173529
