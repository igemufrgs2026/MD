; ============================================================
; EQ4 - NPT: primeiro passo com barostato Berendsen, restraints 100
;            temperatura 280 K
;
; MODIFICACOES:
;   [1] Pcoupl              =  C-rescale
;       MOTIVO: Esta e a PRIMEIRA vez que ativamos o barostato.
;               O Berendsen e mais robusto para equilibrar a
;               pressao inicial porque amorte oscilacoes fortes.
;               O Parrinello-Rahman oscila se a pressao estiver
;               longe de 1 bar quando e ativado - e neste ponto
;               o volume ainda nao esta equilibrado.
;               A troca para Parrinello-Rahman vem depois.
;
;   [2] nsteps = 100000 -> 200 ps  (era 5000 -> 10 ps)
;       MOTIVO: O barostato precisa de tempo para equilibrar
;               o volume da caixa. 10 ps e completamente
;               insuficiente. Recomendado: minimo 100-200 ps.
; ============================================================

title               =  EQ4 - NPT Berendsen 280K restraints 100
define              =  -DPOSRES
constraints         =  all-bonds
integrator          =  md
tinit               =  500
dt                  =  0.002
nsteps              =  100000       ; [2] MODIFICADO: era 5000 (10 ps) -> agora 200 ps
cutoff-scheme       = Verlet
nstlist             = 20
comm-mode           = Linear
comm-grps           = System
nstxout             =  0
nstvout             =  0
nstfout             =  0
nstlog              =  100
nstenergy           =  100
coulombtype         =  PME
rlist               =  1.2
rcoulomb            =  1.2
vdwtype             =  cut-off
rvdw                =  1.2
fourierspacing      =  0.12
fourier_nx          =  0
fourier_ny          =  0
fourier_nz          =  0
pme_order           =  4
ewald_rtol          =  1e-5
optimize_fft        =  yes
Tcoupl              =  v-rescale
tc_grps             =  Protein Non-Protein
tau_t               =  0.1 0.1
ref_t               =  280 280
Pcoupl              =  berendsen
refcoord-scaling    =  all
pcoupltype          =  isotropic
tau_p               =  2
compressibility     =  4.5e-5
ref_p               =  1.0
gen_vel             =  no
gen_temp            =  280.0
gen_seed            =  173529
