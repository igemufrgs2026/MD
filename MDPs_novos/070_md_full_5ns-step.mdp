; ============================================================
; PRODUCAO - Blocos continuados de 5 ns
;
; MODIFICACOES:
;   [1] tinit = 5000.0  (mantido como placeholder)
;       MOTIVO: Este valor e sobrescrito dinamicamente pelo
;               script bash via sed. Mantenha como esta.
;               O script substitui este valor pelo tinit
;               correto a cada iteracao do loop.
; ============================================================

title               =  Producao MD - blocos 5ns continuados
constraints         =  all-bonds
integrator          =  md
tinit               =  5000.0       ; [1] sobrescrito pelo script
dt                  =  0.002
nsteps              =  2500000      ; 5 ns por bloco
cutoff-scheme       = Verlet
nstlist             = 20
comm-mode           = Linear
comm-grps           = System
nstxout             =  5000         ; .trr a cada 10 ps
nstvout             =  5000         ; velocidades a cada 10 ps
nstfout             =  0
nstlog              =  1000         ; .log a cada 2 ps
nstenergy           =  1000         ; .edr a cada 2 ps
nstxout-compressed  =  2500         ; .xtc a cada 5 ps
coulombtype         =  PME
rlist               =  1.2
rcoulomb            =  1.2
vdwtype             =  cut-off
rvdw                =  1.2
fourierspacing      =  0.12
optimize_fft        =  yes
pme_order           =  4
ewald_rtol          =  1e-5
Tcoupl              =  v-rescale
tc_grps             =  Protein Non-Protein
tau_t               =  0.1 0.1
ref_t               =  310 310
Pcoupl              =  parrinello-rahman
Pcoupltype          =  isotropic
tau_p               =  2
compressibility     =  4.5e-5
ref_p               =  1.0
gen_vel             =  no
gen_temp            =  310.0
gen_seed            =  173529
