; ============================================================
; EQ8 - NPT: Parrinello-Rahman, sem restraints, temperatura 310 K
;
; MODIFICACOES:
;   [1] ref_t = 310 310  (era 300 300)
;       MOTIVO: Este e o ultimo passo de equilibracao antes
;               da producao. A temperatura final de producao
;               e 310 K. Terminalizar aqui a 310 K elimina
;               a diferenca de temperatura na entrada da
;               producao, evitando oscilacoes do barostato
;               PR no inicio da trajetoria.
;
;   [2] nsteps = 100000 -> 200 ps  (era 50000 -> 100 ps)
;       MOTIVO: Ultimo passo de equilbracao deve ser longo
;               o suficiente para confirmar que temperatura
;               e pressao estao estaveis em 310 K / 1 bar
;               antes de comecar a coleta de dados.
;
;   [3] tinit atualizado
; ============================================================

title               =  EQ8 - NPT Parrinello-Rahman 310K termalizacao final
constraints         =  all-bonds
integrator          =  md
tinit               =  1300
dt                  =  0.002
nsteps              =  200000       ; [2] MODIFICADO: era 50000 (100 ps) -> agora 400 ps
cutoff-scheme       = Verlet
nstlist             = 20
comm-mode           = Linear
comm-grps           = System
nstxout             =  0
nstvout             =  0
nstfout             =  0
nstlog              =  100
nstenergy           =  100
coulombtype         =  PME
rlist               =  1.2
rcoulomb            =  1.2
vdwtype             =  cut-off
rvdw                =  1.2
fourierspacing      =  0.12
fourier_nx          =  0
fourier_ny          =  0
fourier_nz          =  0
pme_order           =  4
ewald_rtol          =  1e-5
optimize_fft        =  yes
Tcoupl              =  v-rescale
tc_grps             =  Protein Non-Protein
tau_t               =  0.1 0.1
ref_t               =  310 310      ; [1] MODIFICADO: era 300 300
Pcoupl              =  parrinello-rahman
refcoord-scaling    =  all
pcoupltype          =  isotropic
tau_p               =  2
compressibility     =  4.5e-5
ref_p               =  1.0
gen_vel             =  no
gen_temp            =  310.0
gen_seed            =  173529
