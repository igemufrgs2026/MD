; ============================================================
; EQ6 - NPT: Berendsen, sem restraints, temperatura 280 K
;
; MODIFICACOES:
;   [1] Pcoupl = berendsen  (era parrinello-rahman)
;       MOTIVO: Primeiro passo completamente livre de restraints.
;               O sistema vai relaxar e o volume vai mudar.
;               Berendsen ainda e mais seguro aqui.
;               O Parrinello-Rahman entra no proximo passo,
;               depois que o volume ja estiver estabilizado.
;
;   [2] nsteps = 100000 -> 200 ps  (era 5000 -> 10 ps)
;       MOTIVO: Este e um passo critico - e a primeira vez
;               sem nenhum restraint. O sistema precisa de
;               tempo para relaxar estruturalmente.
; ============================================================

title               =  EQ6 - NPT Berendsen 280K sem restraints
constraints         =  all-bonds
integrator          =  md
tinit               =  900
dt                  =  0.002
nsteps              =  100000       ; [2] MODIFICADO: era 5000 (10 ps) -> agora 200 ps
cutoff-scheme       = Verlet
nstlist             = 20
comm-mode           = Linear
comm-grps           = System
nstxout             =  0
nstvout             =  0
nstfout             =  0
nstlog              =  100
nstenergy           =  100
coulombtype         =  PME
rlist               =  1.2
rcoulomb            =  1.2
vdwtype             =  cut-off
rvdw                =  1.2
fourierspacing      =  0.12
fourier_nx          =  0
fourier_ny          =  0
fourier_nz          =  0
pme_order           =  4
ewald_rtol          =  1e-5
optimize_fft        =  yes
Tcoupl              =  v-rescale
tc_grps             =  Protein Non-Protein
tau_t               =  0.1 0.1
ref_t               =  280 280
Pcoupl              =  berendsen    ; [1] MODIFICADO: era parrinello-rahman
refcoord-scaling    =  all
pcoupltype          =  isotropic
tau_p               =  2
compressibility     =  4.5e-5
ref_p               =  1.0
gen_vel             =  no
gen_temp            =  280.0
gen_seed            =  173529
