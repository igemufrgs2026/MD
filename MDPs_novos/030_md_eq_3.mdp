; ============================================================
; EQ3 - NVT: aquecimento para 280 K, restraints altos (1000)
;
; MODIFICACOES:
;   [1] Pcoupl = no  (era berendsen)
;       MOTIVO: Ainda NVT. A temperatura ainda esta subindo.
;               Ativar o barostato antes da temperatura estar
;               estabilizada causa oscilacoes de pressao.
;
;   [2] nsteps = 50000 -> 100 ps  (era 5000 -> 10 ps)
;       MOTIVO: 10 ps e insuficiente para o sistema relaxar
;               apos cada mudanca de restraint e temperatura.
;               O minimo recomendado e 50-100 ps por degrau.
; ============================================================

title               =  EQ3 - NVT 280K restraints 1000
define              =  -DPOSRES
constraints         =  all-bonds
integrator          =  md
tinit               =  400
dt                  =  0.002
nsteps              =  50000        ; [2] MODIFICADO: era 5000 (10 ps) -> agora 100 ps
cutoff-scheme       = Verlet
nstlist             = 20
comm-mode           = Linear
comm-grps           = System
nstxout             =  0
nstvout             =  0
nstfout             =  0
nstlog              =  100
nstenergy           =  100
coulombtype         =  PME
rlist               =  1.2
rcoulomb            =  1.2
vdwtype             =  cut-off
rvdw                =  1.2
fourierspacing      =  0.12
fourier_nx          =  0
fourier_ny          =  0
fourier_nz          =  0
pme_order           =  4
ewald_rtol          =  1e-5
optimize_fft        =  yes
Tcoupl              =  v-rescale
tc_grps             =  Protein Non-Protein
tau_t               =  0.1 0.1
ref_t               =  280 280
Pcoupl              =  no           ; [1] MODIFICADO: era berendsen
refcoord-scaling    =  all
gen_vel             =  no
gen_temp            =  280.0
gen_seed            =  173529
