; ============================================================
; EM1 - Energy minimization with position restraints
; ============================================================

define              =  -DPOSRES
constraints         =  none
integrator          =  steep
nsteps              =  10000
cutoff-scheme       = Verlet
nstlist             = 20
emtol               =  10
emstep              =  0.001
comm-mode           = Linear
comm-grps           = System
coulombtype         =  PME
rlist               =  1.2
rcoulomb            =  1.2
vdwtype             =  cut-off
rvdw                =  1.2
Tcoupl              =  no
Pcoupl              =  no
gen_vel             =  no
